rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      match /recipes/{id} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
      match /expenses/{id} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /lists/{listId} {
      function isMember()  { return isSignedIn() && request.auth.uid in resource.data.members; }
      function isInvited() { return isSignedIn() && request.auth.token.email in resource.data.pendingInvites; }

      allow read:   if isMember() || isInvited();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      // Un membre peut tout modifier ; un invité ne peut que s'ajouter lui-même
      // aux membres et se retirer des invitations en attente, rien d'autre.
      allow update: if isMember() || (
        isInvited() &&
        request.resource.data.members == resource.data.members.concat([request.auth.uid]) &&
        request.resource.data.pendingInvites == resource.data.pendingInvites.removeAll([request.auth.token.email])
      );
      allow delete: if isMember();

      match /items/{itemId} {
        allow read, write: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.members;
      }
    }
  }
}
