rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isListMember(listId) {
      return isSignedIn() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/lists/$(listId)).data.members;
    }

    match /users/{uid}/avatar {
      // Visible par les autres membres d'une liste, modifiable par son propriétaire.
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/recipes/{recipeId}/photo {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /lists/{listId}/cover {
      allow read, write: if isListMember(listId);
    }
  }
}
